{% extends 'base.html.twig' %}

{% block title %}Modifier le Commentaire{% endblock %}

{% block body %}
<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">

            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white text-center rounded-top">
                    <h3 class="mb-0">Modifier le Commentaire</h3>
                </div>

                <div class="card-body p-4">
                    {{ include('commentaire/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
                </div>

                <div class="card-footer bg-light d-flex justify-content-between align-items-center rounded-bottom">
                    <a href="{{ path('app_commentaire_index') }}" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Retour à la liste
                    </a>

                    {{ include('commentaire/_delete_form.html.twig') }}
                </div>
            </div>

        </div>
    </div>
</div>
{% endblock %}
