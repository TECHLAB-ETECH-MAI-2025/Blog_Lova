{% extends 'base.html.twig' %}

{% block title %}Détail du Commentaire{% endblock %}

{% block body %}
<div class="container my-5">
    <h1 class="mb-4">Détail du Commentaire</h1>

    <div class="card shadow-sm">
        <div class="card-body">
            <p class="card-text"><strong>ID :</strong> {{ commentaire.id }}</p>
            <p class="card-text"><strong>Auteur :</strong> {{ commentaire.auteur }}</p>
            <p class="card-text"><strong>Contenu :</strong> {{ commentaire.contenu }}</p>
        </div>
    </div>

    <div class="mt-4 d-flex justify-content-between">
        <a href="{{ path('app_commentaire_index') }}" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Retour à la liste
        </a>

        <div>
            <a href="{{ path('app_commentaire_edit', {'id': commentaire.id}) }}" class="btn btn-warning me-2">
                <i class="bi bi-pencil-square"></i> Modifier
            </a>

            {{ include('commentaire/_delete_form.html.twig') }}
        </div>
    </div>
</div>
{% endblock %}
