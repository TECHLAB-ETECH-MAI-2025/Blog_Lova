{% extends 'base.html.twig' %}

{% block title %}Détail de la Catégorie{% endblock %}

{% block body %}
<div class="container my-5">
    <h1 class="mb-4">Détail de la Catégorie</h1>

    <div class="card shadow-sm">
        <div class="card-body">
            <p class="card-text"><strong>ID :</strong> {{ categorie.id }}</p>
            <p class="card-text"><strong>Nom :</strong> {{ categorie.nom }}</p>
        </div>
    </div>

    <div class="mt-4 d-flex justify-content-between">
        <a href="{{ path('app_categorie_index') }}" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Retour à la liste
        </a>

        <div>
            <a href="{{ path('app_categorie_edit', {'id': categorie.id}) }}" class="btn btn-warning me-2">
                <i class="bi bi-pencil-square"></i> Modifier
            </a>

            {{ include('categorie/_delete_form.html.twig') }}
        </div>
    </div>

    {% if categorie.articles is not empty %}
        <div class="card shadow-sm mt-5">
            <div class="card-header bg-info text-white">
                Articles dans cette catégorie
            </div>
            <ul class="list-group list-group-flush">
                {% for article in categorie.articles %}
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span>{{ article.titre }}</span>
                        <a href="{{ path('app_article_show', {'id': article.id}) }}" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-eye"></i> Voir
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </div>
    {% else %}
        <div class="alert alert-info mt-4">
            Aucun article n'est encore lié à cette catégorie.
        </div>
    {% endif %}
</div>
{% endblock %}
