{% extends 'base.html.twig' %}

{% block title %}Categorie{% endblock %}

{% block body %}
    <h1>Categorie</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ categorie.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ categorie.nom }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_categorie_index') }}">back to list</a>

    <a href="{{ path('app_categorie_edit', {'id': categorie.id}) }}">edit</a>

    {{ include('categorie/_delete_form.html.twig') }}
    {% if categorie.articles is not empty %}
    <div class="mt-4">
        <h5 class="text-primary">Articles dans cette catégorie :</h5>
        <ul class="list-group shadow-sm mt-3">
            {% for article in categorie.articles %}
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span>{{ article.titre }}</span>
                    <a href="{{ path('app_article_show', {'id': article.id}) }}" class="btn btn-outline-primary btn-sm">
                        Voir
                    </a>
                </li>
            {% endfor %}
        </ul>
    </div>
{% else %}
    <div class="alert alert-info mt-4">
        Aucun article n'est encore lié à cette catégorie.
    </div>
{% endif %}

{% endblock %}
