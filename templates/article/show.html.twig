{% extends 'base.html.twig' %}

{% block title %}Détail de l’Article{% endblock %}

{% block body %}
<div class="container my-5">
    <h1 class="mb-4">Détail de l’Article</h1>

    <div class="card shadow-sm">
        <div class="card-body">
            <h5 class="card-title text-primary">Titre : {{ article.titre }}</h5>
            <p class="card-text"><strong>ID :</strong> {{ article.id }}</p>
            <p class="card-text"><strong>Contenu :</strong> {{ article.contenu }}</p>
        </div>
    </div>

    <div class="mt-4 d-flex justify-content-between">
        <a href="{{ path('app_article_index') }}" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Retour à la liste
        </a>

        <div>
            <a href="{{ path('app_article_edit', {'id': article.id}) }}" class="btn btn-warning me-2">
                <i class="bi bi-pencil-square"></i> Modifier
            </a>

            {{ include('article/_delete_form.html.twig') }}
        </div>
    </div>
</div>
{% endblock %}
