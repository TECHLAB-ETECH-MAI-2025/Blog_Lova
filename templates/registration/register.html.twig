{% extends 'base.html.twig' %}

{% block title %}Créer un compte{% endblock %}

{% block body %}
<link rel="stylesheet" href="{{ asset('bootstrap/css/bootstrap.min.css') }}">

<div class="container d-flex justify-content-center align-items-center" style="min-height: 100vh; background-color: #f8f9fa;">
    <div class="card shadow-lg p-4 border-0" style="max-width: 420px; width: 100%; border-radius: 1rem;">
        
        <div class="text-center mb-4">
            <img src="https://cdn-icons-png.flaticon.com/512/3064/3064197.png" alt="Register Icon" width="70" class="mb-2">
            <h3 class="fw-bold">Créer un compte</h3>
            <p class="text-muted">Veuillez remplir les champs pour vous inscrire</p>
        </div>

        {% for message in app.flashes('error') %}
            <div class="alert alert-danger">{{ message }}</div>
        {% endfor %}

        {{ form_start(registrationForm) }}

            <div class="mb-3">
                {{ form_label(registrationForm.nom, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(registrationForm.nom, {'attr': {'class': 'form-control rounded-pill px-4 py-2'}}) }}
                {{ form_errors(registrationForm.nom) }}
            </div>

            <div class="mb-3">
                {{ form_label(registrationForm.email, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(registrationForm.email, {'attr': {'class': 'form-control rounded-pill px-4 py-2'}}) }}
                {{ form_errors(registrationForm.email) }}
            </div>

            <div class="mb-4">
                {{ form_label(registrationForm.plainPassword, 'Mot de passe', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(registrationForm.plainPassword, {'attr': {'class': 'form-control rounded-pill px-4 py-2'}}) }}
                {{ form_errors(registrationForm.plainPassword) }}
            </div>

            <div class="d-grid mb-3">
                <button type="submit" class="btn btn-primary rounded-pill py-2">S’inscrire</button>
            </div>

        {{ form_end(registrationForm) }}

        <div class="text-center mt-3">
            <a href="{{ path('app_login') }}" class="btn btn-outline-primary btn-sm rounded-pill px-4">
                J’ai déjà un compte
            </a>
        </div>
    </div>
</div>
{% endblock %}
