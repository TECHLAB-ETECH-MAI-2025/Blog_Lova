<form method="post" action="{{ path('app_commentaire_delete', {'id': commentaire.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet élément ?');" aria-label="Supprimer le commentaire {{ commentaire.id }}">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ commentaire.id) }}">
    {# Optionnel si tu utilises la méthode DELETE en REST #}
    <input type="hidden" name="_method" value="DELETE">
    <button type="submit" class="btn btn-danger">
        Supprimer
    </button>
</form>

